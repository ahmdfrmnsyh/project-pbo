<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.penilaian.LoginController"
            prefWidth="450" prefHeight="350">

    <children>
        <VBox spacing="15" alignment="CENTER"
              layoutX="50" layoutY="40"
              prefWidth="350">
            <children>

                <Label text="Sistem Penilaian Kinerja Karyawan"
                       style="-fx-font-size: 20px; -fx-font-weight: bold;" />

                <VBox spacing="8">
                    <children>
                        <Label text="Username"/>
                        <TextField fx:id="txtUser"
                                   promptText="Masukkan username"
                                   style="-fx-padding: 8;" />
                    </children>
                </VBox>

                <VBox spacing="8">
                    <children>
                        <Label text="Password"/>
                        <PasswordField fx:id="txtPass"
                                       promptText="Masukkan password"
                                       style="-fx-padding: 8;" />
                    </children>
                </VBox>

                <Button fx:id="btnLogin"
                        text="Masuk"
                        onAction="#handleLogin"
                        style="
                            -fx-background-color: #2754ae;
                            -fx-text-fill: white;
                            -fx-font-size: 14px;
                            -fx-padding: 10 20;
                            -fx-background-radius: 6;" />


                <Label fx:id="lblStatus" textFill="red"/>

            </children>
        </VBox>
    </children>

</AnchorPane>
