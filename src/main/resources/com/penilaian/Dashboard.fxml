<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.penilaian.DashboardController"
            prefWidth="900" prefHeight="600">

    <left>
        <VBox spacing="15" style="-fx-background-color:#2c3e50; -fx-padding:20;">
            <children>

                <Label text="MENU" 
                       style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;" />

                <Button text="Dashboard"
                        style="-fx-background-color:#34495e; -fx-text-fill:white;" />

                <Button text="Data Karyawan"
                        style="-fx-background-color:#34495e; -fx-text-fill:white;" />

                <Button text="Penilaian"
                        style="-fx-background-color:#34495e; -fx-text-fill:white;" />

                <Button text="Logout"
                        style="-fx-background-color:#e74c3c; -fx-text-fill:white;" />

            </children>
        </VBox>
    </left>

    <center>
        <StackPane>
            <children>
                <Label fx:id="lblWelcome" style="-fx-font-size:24;" />
            </children>
        </StackPane>
    </center>

</BorderPane>
